; The tests of the parts of the core that need no world, for example the
; commit protocol.

(test
 (name test_core)
 (libraries weft windtrap)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_commit.ml test_commit.ml.corrected)
   (diff? test_world.ml test_world.ml.corrected)
   (diff? test_heap.ml test_heap.ml.corrected))))
