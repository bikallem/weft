(executable
 (name echo_client)
 (enabled_if
  (= %{system} linux))
 (modules echo_client)
 (libraries unix))

(executable
 (name no_threads)
 (enabled_if
  (= %{system} linux))
 (modules no_threads)
 (libraries weft weft.linux))

(executable
 (name few_fds)
 (enabled_if
  (= %{system} linux))
 (modules few_fds)
 (libraries weft weft.linux))

(executable
 (name unwatch)
 (enabled_if
  (= %{system} linux))
 (modules unwatch)
 (libraries weft weft.linux unix))

; An executable and a rule, not a test stanza: on another system, dune
; builds the executable of a test stanza also if its enabled_if is false.

(executable
 (name test_linux)
 (enabled_if
  (= %{system} linux))
 (modules test_linux)
 (libraries weft weft.linux windtrap portable unix))

(rule
 (alias runtest)
 (enabled_if
  (= %{system} linux))
 (deps echo_client.exe no_threads.exe few_fds.exe unwatch.exe)
 (action
  (setenv
   WEFT_ECHO_CLIENT
   %{dep:echo_client.exe}
   (setenv
    WEFT_NO_THREADS
    %{dep:no_threads.exe}
    (setenv
     WEFT_FEW_FDS
     %{dep:few_fds.exe}
     (setenv
      WEFT_UNWATCH
      %{dep:unwatch.exe}
      (progn
       (run %{exe:test_linux.exe} --corrected)
       (diff? test_linux.ml test_linux.ml.corrected))))))))
