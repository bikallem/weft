; The suites on the simulator world. Windtrap links unix, so these suites
; cannot use (forbidden_libraries unix); test/nounix is the guard. The test
; code itself must not call Unix.

(test
 (name test_sim)
 (libraries weft weft.sim windtrap portable)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_sim.ml test_sim.ml.corrected)
   (diff? test_net.ml test_net.ml.corrected)
   (diff? test_m1.ml test_m1.ml.corrected)
   (diff? test_m2.ml test_m2.ml.corrected))))
