; The tests of the kqueue world, on macOS and FreeBSD. An executable and a
; rule, as in test/linux.

(executable
 (name test_kqueue)
 (enabled_if
  (or
   (= %{system} macosx)
   (= %{system} freebsd)))
 (modules test_kqueue)
 (libraries weft weft.kqueue windtrap portable unix))

(executable
 (name unwatch)
 (enabled_if
  (or
   (= %{system} macosx)
   (= %{system} freebsd)))
 (modules unwatch)
 (libraries weft.kqueue unwatch_main))

(rule
 (alias runtest)
 (enabled_if
  (or
   (= %{system} macosx)
   (= %{system} freebsd)))
 (action
  (setenv
   WEFT_UNWATCH
   %{dep:unwatch.exe}
   (run %{exe:test_kqueue.exe}))))
