# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Concurrency for OCaml 5 with CML events and a deterministic simulator"
description:
  "Weft runs fibers on OCaml 5 domains. Its events come from Concurrent ML. All operating system calls are effects, so a simulator can run the same program with a virtual clock and network."
maintainer: ["Bikal Gurung <gbikal@gmail.com>"]
authors: ["Bikal Gurung <gbikal@gmail.com>"]
license: "ISC"
homepage: "https://github.com/bikallem/weft"
bug-reports: "https://github.com/bikallem/weft/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.5"}
  "windtrap" {with-test & >= "0.2.0"}
  "ppx_windtrap" {with-test & >= "0.2.0"}
  "dscheck" {with-test & >= "0.6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/bikallem/weft.git"
