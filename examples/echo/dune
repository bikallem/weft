; An echo server. The same code runs on the OS (echo_server.exe) and in the
; simulator (test_echo.ml).

(library
 (name echo)
 (modules echo)
 (libraries weft))

(executable
 (name echo_server)
 (modules echo_server)
 (libraries echo weft weft.os))

(test
 (name test_echo)
 (modules test_echo)
 (libraries echo weft weft.sim))
