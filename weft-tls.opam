# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TLS flows for weft, with ocaml-tls"
description:
  "Weft_tls makes a TLS flow of weft.flow from another flow, as a server or as a client, with ocaml-tls. A read and a write can run at the same time in two fibers. A client can start TLS in the middle of a protocol, after bytes in clear text."
maintainer: ["Bikal Gurung <gbikal@gmail.com>"]
authors: ["Bikal Gurung <gbikal@gmail.com>"]
license: "MPL-2.0"
homepage: "https://github.com/bikallem/weft"
bug-reports: "https://github.com/bikallem/weft/issues"
depends: [
  "dune" {>= "3.17"}
  "weft" {= version}
  "tls" {>= "2.1.3"}
  "mirage-crypto-rng"
  "windtrap" {with-test & >= "0.2.0"}
  "ppx_windtrap" {with-test & >= "0.2.0"}
  "x509" {with-test}
  "domain-name" {with-test}
  "ipaddr" {with-test}
  "ptime" {with-test}
  "dscheck" {with-test & >= "0.6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/bikallem/weft.git"
