; The Linux world: epoll, timerfd and eventfd (design section 2.7). Its own
; stubs and those of weft.posix do each OS call, so it does not link unix.

(library
 (name weft_linux)
 (public_name weft.linux)
 (enabled_if
  (= %{system} linux))
 (libraries weft weft.posix)
 (foreign_stubs
  (language c)
  (flags
   (:standard -O2 -Wall -Wextra -Wno-unused-parameter))
  (names weft_linux_stubs weft_proc))
 (c_library_flags -lpthread)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))
