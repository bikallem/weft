; The parts that the worlds share: Linux, macOS, FreeBSD and Windows (design
; section 2.7). The worlds add their poller. On Windows, the stubs of
; weft_win_stubs.c and weft_win_io.c replace those of weft_posix_stubs.c and
; weft_spawn.c, and weft_win_io.c also has the poller of weft.windows. On
; Windows, the link of OCaml gives the static library of winpthreads
; (-l:libpthread.a): a -lpthread here would need libwinpthread-1.dll.

(library
 (name weft_posix)
 (public_name weft.posix)
 (enabled_if
  (or
   (= %{system} linux)
   (= %{system} macosx)
   (= %{system} freebsd)
   (= %{os_type} Win32)))
 (libraries weft)
 (foreign_stubs
  (language c)
  (flags
   (:standard -O2 -Wall -Wextra -Wno-unused-parameter))
  (extra_deps weft_posix.h weft_win.h)
  (names
   weft_posix_stubs
   weft_pool
   weft_watchdog
   weft_spawn
   weft_win_stubs
   weft_win_io))
 (c_library_flags
  (:include c_library_flags.sexp))
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (with-stdout-to
   c_library_flags.sexp
   (echo "(-lpthread)"))))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (action
  (with-stdout-to
   c_library_flags.sexp
   (echo "(-lws2_32 -lbcrypt)"))))
